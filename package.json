{
  "name": "@pycolors/tokens",
  "version": "1.2.3",
  "description": "CSS and framework-independent native design tokens for PyColors.",
  "keywords": [
    "pycolors",
    "design-tokens",
    "css-variables",
    "tailwind",
    "theming",
    "dark-mode"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "sideEffects": [
    "./tokens.css"
  ],
  "files": [
    "tokens.css",
    "native.js",
    "native.d.ts",
    "native.provenance.json",
    "appearance.snapshot.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./tokens.css": "./tokens.css",
    "./native": {
      "types": "./native.d.ts",
      "import": "./native.js",
      "default": "./native.js"
    }
  },
  "scripts": {
    "native:generate": "node scripts/generate-native.mjs",
    "native:check": "node scripts/generate-native.mjs --check",
    "build": "node scripts/generate-native.mjs --check",
    "lint": "node --check native.js && node --check scripts/native-color.mjs && node --check scripts/generate-native.mjs",
    "types:check": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pycolors-io/pycolors-tokens"
  },
  "bugs": {
    "url": "https://github.com/pycolors-io/pycolors-tokens/issues"
  },
  "homepage": "https://github.com/pycolors-io/pycolors/tree/main/packages/tokens#readme"
}
